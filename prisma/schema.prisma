// Spa CRM - reverse-engineered from Tyra Mom & Baby Spa pattern
// Service-business CRM with WA AI agent + handoff queue

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  receptionist
  therapist
}

enum AppointmentStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum PaymentMethod {
  cash
  card
  transfer
  qris
}

enum PaymentType {
  dp
  settlement
  full
}

enum TransactionStatus {
  unpaid
  partial
  paid
  refunded
  cancelled
}

enum WaDirection {
  in
  out
}

enum WaSource {
  ai_agent
  human
  system
}

enum HandoffStatus {
  pending
  active
  resolved
  expired
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(receptionist)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id              String   @id @default(cuid())
  name            String
  phone           String   @unique
  normalizedPhone String   @unique
  email           String?
  birthDate       DateTime?
  address         String?
  skinType        String?
  allergies       String?
  notes           String?
  // CRM fields
  tags            String[]   @default([])
  totalBookings   Int        @default(0)
  totalSpent      Float      @default(0)
  lastVisit       DateTime?
  isActive        Boolean    @default(true)
  // AI toggle per-customer
  aiEnabled        Boolean  @default(true)
  // abuse tracking
  dailyMessageCount Int      @default(0)
  dailyTokenCost    Float    @default(0)
  abuseFlags        Int      @default(0)
  mutedUntil        DateTime?
  lastResetAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointments Appointment[]
  waMessages   WaMessage[]
  handoffs     Handoff[]

  @@index([normalizedPhone])
}

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(12, 2)
  category        String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]
  transactions Transaction[]

  @@index([isActive])
}

model Therapist {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  specialties  String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id           String            @id @default(cuid())
  customerId   String
  serviceId    String
  therapistId  String?
  scheduledAt  DateTime
  status       AppointmentStatus @default(pending)
  notes        String?
  source       String            @default("web")
  // cancellation
  cancelReason String?
  cancelledAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id])
  therapist    Therapist?    @relation(fields: [therapistId], references: [id])
  transactions Transaction[]

  @@index([customerId])
  @@index([therapistId])
  @@index([scheduledAt])
  @@index([status])
}

model Transaction {
  id            String            @id @default(cuid())
  appointmentId String
  serviceId     String?
  type          PaymentType       @default(full)
  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  status        TransactionStatus @default(unpaid)
  // Midtrans QRIS fields
  midtransOrderId      String?  @unique
  midtransTxnId        String?
  midtransQrString     String?  @db.Text
  midtransQrUrl        String?  @db.Text
  midtransExpiresAt    DateTime?
  midtransLastStatus   String?
  midtransRawNotif     Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
  @@index([status])
  @@index([paidAt])
  @@index([midtransOrderId])
  @@index([type])
}

model WaMessage {
  id              String      @id @default(cuid())
  customerId      String?
  sessionId       String?
  normalizedPhone String?
  remoteJid       String?
  waMessageId     String?
  direction       WaDirection
  source          WaSource    @default(ai_agent)
  messageType     String?     @default("text")
  content         String      @db.Text
  status          String?     @default("received")
  intent          String?
  confidence      Float?
  tokensUsed      Int?
  processingMs    Int?
  model           String?
  aiTokensIn      Int?
  aiTokensOut     Int?
  aiCostUsd       Float?
  aiBlocked       Boolean     @default(false)
  metadata        Json?
  sentAt          DateTime    @default(now())
  createdAt       DateTime    @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([sentAt])
  @@index([intent])
}

model Handoff {
  id         String         @id @default(cuid())
  customerId String?
  sessionId  String         @unique
  reason     String?
  status     HandoffStatus  @default(pending)
  priority   Int            @default(0)
  assignedTo String?
  resolvedBy String?
  resolvedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model Settings {
  id                          Int      @id @default(1)
  businessName                String   @default("Spa CRM")
  address                     String?
  phone                       String?
  email                       String?
  waNumber                    String?
  logoUrl                     String?
  qrisImageUrl                String?
  bookingPaymentInstructions  String?  @db.Text
  pendingPaymentExpiryMinutes Int      @default(120)
  minimalDpPercent            Int      @default(50)
  // AI config
  aiModel                String   @default("GG")
  aiBaseUrl              String   @default("http://127.0.0.1:20128/v1")
  aiKnowledgeBase        String?  @db.Text
  aiSafetyRules          String?  @db.Text
  aiHandoffKeywords      String[] @default([])
  aiAllowedTopics        String[] @default([])
  aiOffTopicReply        String   @default("Maaf, gue cuma bantu seputar layanan & booking. Kalau butuh info lain, hubungi staff ya.")
  aiMaxOutputTokens      Int      @default(300)
  // Abuse limits
  abuseDailyMsgPerPhone  Int      @default(30)
  abuseDailyCostPerPhone Float    @default(0.05)
  abuseGlobalDailyBudget Float    @default(5.0)
  abuseFlagThreshold     Int      @default(3)
  // Telemetry
  globalDailyCost        Float    @default(0)
  globalCostResetAt      DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/spa_crm?schema=public"

# ─── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET="change-me"

# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Rspa CRM"

# ─── AI Provider (OpenAI-compatible: Claude/GPT/MiMo via gateway) ──────
AI_BASE_URL="https://your-gateway.example/v1"
AI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AI_MODEL="gpt-4o-mini"

# ─── WhatsApp Worker (Baileys) ─────────────────────────────────────────
WA_WORKER_PORT=3020
WA_WORKER_TOKEN="change-me"
APP_BASE_URL="https://your-app.example"
APP_INTERNAL_TOKEN="change-me"

# ─── Midtrans (QRIS) ───────────────────────────────────────────────────
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx"
MIDTRANS_MERCHANT_ID="Mxxxxx"
MIDTRANS_BASE="https://api.sandbox.midtrans.com"
MIDTRANS_IS_PRODUCTION=false
